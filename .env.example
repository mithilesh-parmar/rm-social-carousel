# Required for the `generate` command (Planner/Writer/Critic). Not needed for `render`.
ANTHROPIC_API_KEY=

# Optional — only needed if a stage's provider is overridden to openai (see src/content/models.js).
OPENAI_API_KEY=

# Optional per-stage overrides. Values: anthropic | openai
# PLANNER_PROVIDER=
# PLANNER_MODEL=
# WRITER_PROVIDER=
# WRITER_MODEL=
# CRITIC_PROVIDER=
# CRITIC_MODEL=
